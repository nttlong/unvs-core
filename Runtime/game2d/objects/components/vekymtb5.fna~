using System;
using System.Linq;
using System.Reflection;
using Unity.VisualScripting;
using UnityEngine;
using unvs.types;

namespace unvs.game2d.objects.components
{
    
        public abstract class UnvsBaseComponent : MonoBehaviour
    {
        

#if UNITY_EDITOR
        public Action<string> OnEditorError;
        public void RaiseEditorError(string error)
        {
            OnEditorError?.Invoke(error);
        }
        public virtual void OnDrawGizmos()
        {
            var fields= unvs.editor.utils.UnvsEditorUtils.GetAllGenericFields(this,typeof(UnvsProperty<>));
            foreach (var field in fields)
            {
                Debug.Log( field.FieldType.GenericTypeArguments[0].ToString());
                var propertyInstance = field.GetValue(this);
                var ownerField = field.FieldType.GetField("Owner",
    BindingFlags.Public | BindingFlags.Instance | BindingFlags.FlattenHierarchy);

                if (ownerField != null)
                {
                    ownerField.SetValue(propertyInstance,this.GetComponent(field.FieldType.GenericTypeArguments[0]));


                }
            }
           

        }
#endif


    }
}